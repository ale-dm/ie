{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technique.schema.json",
  "title": "Técnica",
  "description": "Campos definidos en el GDD, sección 4.2.",
  "type": "object",
  "required": ["id", "nombre", "tipo", "huecos"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "nombre": { "type": "string" },
    "tipo": {
      "enum": ["supertecnica-estandar", "hipertecnica-combinada", "transformacion-basica", "transformacion-avanzada"]
    },
    "huecos": { "description": "1 estándar / transformación básica; 2 hiper-combinada / transformación avanzada.", "enum": [1, 2] }
  },
  "allOf": [
    { "if": { "properties": { "tipo": { "enum": ["supertecnica-estandar", "transformacion-basica"] } } },
      "then": { "properties": { "huecos": { "const": 1 } } },
      "else": { "properties": { "huecos": { "const": 2 } } } }
  ]
}
