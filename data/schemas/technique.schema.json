{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technique.schema.json",
  "title": "Técnica",
  "description": "Campos definidos en el GDD, sección 4.2.",
  "type": "object",
  "required": [
    "id",
    "nombre",
    "tipo",
    "huecos"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "nombre": {
      "type": "string"
    },
    "tipo": {
      "enum": [
        "supertecnica-estandar",
        "hipertecnica-combinada",
        "transformacion-basica",
        "transformacion-avanzada"
      ]
    },
    "huecos": {
      "description": "Todas las técnicas ocupan 1 hueco (GDD 4.2).",
      "const": 1
    }
  }
}
