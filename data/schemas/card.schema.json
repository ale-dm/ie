{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card.schema.json",
  "title": "Carta",
  "description": "Campos definidos en el GDD, secciones 2 y 4.1.",
  "type": "object",
  "required": ["id", "personaje", "version", "posicion", "equipo", "elemento", "era", "tipo", "stats", "huecos", "tecnicas"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "personaje": { "type": "string" },
    "version": { "type": "string" },
    "posicion": { "enum": ["PR", "DF", "MC", "DL"] },
    "equipo": { "type": "string" },
    "elemento": { "enum": ["fuego", "aire", "tierra", "bosque"] },
    "era": { "enum": ["IE1", "IE2", "IE3", "GO", "GO2", "GO3", "ARES", "ORION", "VR"] },
    "tipo": { "enum": ["bronce", "plata", "oro", "especial"] },
    "stats": {
      "type": "object",
      "required": ["ATT", "CTL", "DEF"],
      "additionalProperties": false,
      "properties": {
        "ATT": { "type": "integer", "minimum": 1, "maximum": 100 },
        "CTL": { "type": "integer", "minimum": 1, "maximum": 100 },
        "DEF": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "huecos": { "enum": [4, 5, 6] },
    "tecnicas": {
      "description": "Ids de técnica. Un id puede repetirse (huecos 5 y 6, ver docs/decisiones.md). La suma de huecos ocupados no puede superar 'huecos'.",
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    { "if": { "properties": { "tipo": { "enum": ["bronce", "plata", "oro"] } } },
      "then": { "properties": { "huecos": { "const": 4 } } },
      "else": { "properties": { "huecos": { "enum": [5, 6] } } } }
  ]
}
